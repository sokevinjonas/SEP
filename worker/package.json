{
  "name": "sep-backend",
  "version": "1.0.0",
  "description": "Cloudflare Workers serverless backend for Student Savings",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:all": "wrangler d1 execute sep-d1 --remote --file=./schema.sql -y && wrangler deploy",
    "types": "wrangler types",
    "d1:init:remote": "wrangler d1 execute sep-d1 --remote --file=./schema.sql -y",
    "d1:init:local": "wrangler d1 execute sep-d1 --local --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240405.0",
    "typescript": "^5.4.0",
    "wrangler": "^3.50.0"
  }
}
